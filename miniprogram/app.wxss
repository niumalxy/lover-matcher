/* 公共样式 */
page {
  background: #f6f7f9;
  color: #222;
  font-size: 28rpx;
}

.container {
  padding: 32rpx;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.btn-primary {
  background: #ff6b81;
  color: #fff;
  border-radius: 12rpx;
  padding: 20rpx;
  text-align: center;
}

.btn-secondary {
  background: #fff;
  color: #444;
  border: 1rpx solid #ddd;
  border-radius: 12rpx;
  padding: 20rpx;
  text-align: center;
}

.muted {
  color: #999;
  font-size: 24rpx;
}

.tag {
  display: inline-block;
  background: #ffe9ee;
  color: #d44760;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  margin: 4rpx 8rpx 4rpx 0;
}
