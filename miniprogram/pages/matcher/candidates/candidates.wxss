.gender-bar {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.gender-tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  border-radius: 16rpx;
  background: #f3f4f6;
  font-size: 28rpx;
  color: #666;
}

.gender-tab.active {
  background: #ffd6dd;
  color: #d44760;
  font-weight: 600;
}

.me-tag {
  font-size: 22rpx;
  background: #d44760;
  color: #fff;
  padding: 2rpx 12rpx;
  border-radius: 10rpx;
  font-weight: 500;
}

.card {
  cursor: pointer;
}
