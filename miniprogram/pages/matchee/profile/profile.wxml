<view class="container">
  <view class="card">
    <view style="font-weight: 600; font-size: 30rpx; margin-bottom: 8rpx;">用一段话写自己 + 择偶标准</view>
    <view class="muted" style="margin-bottom: 16rpx;">越具体越好，AI 会保留你的语言风格。例：「我是XX，XX岁，喜欢...，希望对方...」</view>
    <textarea class="ta" value="{{raw_input}}" bindinput="onRawInput" placeholder="开始写..." auto-height maxlength="-1" />
    <view style="margin-top: 16rpx;">
      <view class="btn-primary" bindtap="onExtract">{{extracting ? '提取中...' : 'AI 提取结构化标准'}}</view>
    </view>
  </view>

  <block wx:if="{{hasStructured}}">
    <view class="card">
      <view class="label">自我介绍</view>
      <textarea class="ta" value="{{self_intro}}" bindinput="onIntroInput" auto-height />

      <view class="label">性格关键词（每行一个）</view>
      <textarea class="ta" value="{{personality_text}}" bindinput="onPersonalityInput" auto-height />

      <view class="label">爱好（每行一个）</view>
      <textarea class="ta" value="{{hobbies_text}}" bindinput="onHobbiesInput" auto-height />

      <view class="label">硬性要求（每行一个）</view>
      <textarea class="ta" value="{{hard_text}}" bindinput="onHardInput" auto-height />

      <view class="label">软性要求（每行一个）</view>
      <textarea class="ta" value="{{soft_text}}" bindinput="onSoftInput" auto-height />

      <view class="label">说话风格（供智能助手模仿）</view>
      <textarea class="ta" value="{{speaking_style}}" bindinput="onStyleInput" auto-height />
    </view>

    <view class="btn-primary" bindtap="onSubmit">{{saving ? '保存中...' : '保存并进入候选池'}}</view>
  </block>
</view>
